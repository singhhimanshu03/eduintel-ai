# ═══════════════════════════════════════════════════════════════════════════════
# EduIntel AI — Root Environment Variables
# Copy this file to .env: cp .env.example .env
# Then fill in your actual values before running docker compose up.
# ═══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=eduintel
POSTGRES_PASSWORD=change_this_strong_db_password

# ── Security ───────────────────────────────────────────────────────────────────
# Used by all Node.js services to authenticate internal service-to-service calls.
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_SECRET=change_this_to_a_64_char_random_hex_string

# ── JWT (RS256) ────────────────────────────────────────────────────────────────
# Private/public key pair is auto-generated by scripts/generate-keys.sh
# and mounted as volumes in docker-compose.yml.
# These paths are inside the containers — do NOT change unless you change the volume mounts.
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_COST=12

# ── Redis ──────────────────────────────────────────────────────────────────────
# Redis is used for: rate limiting, response caching, refresh token allowlisting,
# pub/sub for real-time in-app notifications.
REDIS_URL=redis://redis:6379

# ── SMTP — Email Delivery ──────────────────────────────────────────────────────
# Used by: auth-service (verification/reset emails) and notification-service (alerts)
# For Gmail: use an App Password (not your main password) with 2FA enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@eduintel.edu

# ── Node Environment ───────────────────────────────────────────────────────────
NODE_ENV=production

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# ── Dashboard Cache ────────────────────────────────────────────────────────────
DASHBOARD_CACHE_TTL=300

# ── Attendance Threshold ───────────────────────────────────────────────────────
# Minimum attendance percentage required for hall ticket eligibility (default 75%)
DEFAULT_ELIGIBILITY_THRESHOLD=75

# ── Document Upload ────────────────────────────────────────────────────────────
MAX_DOCUMENT_SIZE_MB=10

# ── Docker Hub (CI/CD only — set in GitHub Actions secrets) ───────────────────
# DOCKER_USERNAME=your-dockerhub-username
# DOCKER_PASSWORD=your-dockerhub-password
