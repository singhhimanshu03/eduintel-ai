# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Build output
dist/
build/

# Environment files
.env
.env.local
.env.production

# JWT Keys — NEVER commit real keys
keys/private.pem
keys/public.pem

# AI model binaries
ai-service/app/models/*.pkl
ai-service/training/data/

# Logs
*.log
logs/

# Docker volumes
pgdata/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Playwright test output & config (not needed for deployment)
playwright-report/
test-results/
pw-exit.txt

# Playwright root config files (E2E only, not needed on server)
playwright.config.ts
tsconfig.playwright.json
package-lock.json

# Debug/diagnostic scripts (already deleted, prevent re-addition)
scripts/diag-*.js
scripts/dump-*.js
scripts/parse-report.js
scripts/extract-failures.js

# Build artifacts (regenerated by Docker)
services/*/dist/
frontend/dist/

# Dev-time notes
TESTING_CHECKPOINT.md
FINAL_COMPLETION_REPORT.md

# Binary archives
*.zip

# Docker override (empty dev file)
docker-compose.override.yml
