# ── Student Service Environment Variables ─────────────────────────────────────
NODE_ENV=production
PORT=3002

# PostgreSQL
DATABASE_URL=postgresql://eduintel:eduintel_pass@postgres:5432/student_db

# Redis (optional — for caching)
REDIS_URL=redis://redis:6379

# Internal service authentication secret (shared across all services)
INTERNAL_SERVICE_SECRET=change_this_to_a_long_random_string

# Max document upload size in MB
MAX_DOCUMENT_SIZE_MB=10

# Notification service URL (for sending student-related alerts)
NOTIFICATION_SERVICE_URL=http://notification-service:3007
