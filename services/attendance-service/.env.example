# ── Attendance Service Environment Variables ───────────────────────────────────
NODE_ENV=production
PORT=3004

# PostgreSQL
DATABASE_URL=postgresql://eduintel:eduintel_pass@postgres:5432/attendance_db

# Redis (used for caching analytics)
REDIS_URL=redis://redis:6379

# Internal service authentication secret (shared across all services)
INTERNAL_SERVICE_SECRET=change_this_to_a_long_random_string

# Notification service URL
NOTIFICATION_SERVICE_URL=http://notification-service:3007

# Eligibility threshold for hall ticket (default 75%)
DEFAULT_ELIGIBILITY_THRESHOLD=75
