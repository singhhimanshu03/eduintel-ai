# ── API Gateway Environment Variables ─────────────────────────────────────────
GATEWAY_PORT=80

# JWT — RS256 public key path (mounted volume in Docker)
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem

# Internal service authentication secret (shared across all services)
INTERNAL_SERVICE_SECRET=change_this_to_a_long_random_string

# Redis
REDIS_URL=redis://redis:6379

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200

# Downstream service URLs
AUTH_SERVICE_URL=http://auth-service:3001
STUDENT_SERVICE_URL=http://student-service:3002
FACULTY_SERVICE_URL=http://faculty-service:3003
ATTENDANCE_SERVICE_URL=http://attendance-service:3004
EXAM_SERVICE_URL=http://examination-service:3005
FEE_SERVICE_URL=http://fee-service:3006
NOTIFICATION_SERVICE_URL=http://notification-service:3007
PLACEMENT_SERVICE_URL=http://placement-service:3008
ANALYTICS_SERVICE_URL=http://analytics-service:3009
AI_SERVICE_URL=http://ai-service:8000
