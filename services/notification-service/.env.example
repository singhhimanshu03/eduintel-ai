# ── Notification Service Environment Variables ─────────────────────────────────
NODE_ENV=production
PORT=3007

# PostgreSQL
DATABASE_URL=postgresql://eduintel:eduintel_pass@postgres:5432/notification_db

# Redis (used for pub/sub in-app notifications)
REDIS_URL=redis://redis:6379

# SMTP — for email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-password-or-app-password
FROM_EMAIL=noreply@eduintel.edu

# Internal service authentication secret (all incoming requests must include this)
INTERNAL_SERVICE_SECRET=change_this_to_a_long_random_string
